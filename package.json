{
  "name": "tuddofs",
  "version": "0.1.0",
  "type": "module",
  "description": "A multi-tenant, permission-confined, branchable filesystem for AI agents, built on Postgres and object storage.",
  "workspaces": [
    "packages/s3"
  ],
  "author": "Rod Amora",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodamora/tuddofs.git"
  },
  "bugs": {
    "url": "https://github.com/rodamora/tuddofs/issues"
  },
  "homepage": "https://github.com/rodamora/tuddofs#readme",
  "keywords": [
    "ai-agents",
    "filesystem",
    "multi-tenant",
    "postgres",
    "object-storage",
    "branching",
    "content-addressed-storage"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:s3",
    "build:core": "tsc -p tsconfig.json --incremental false",
    "build:s3": "npm run build --workspace @tuddofs/s3",
    "test": "npm run test:core && npm run test:s3",
    "test:core": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:minio": "node scripts/run-tests.mjs minio",
    "test:s3": "npm test --workspace @tuddofs/s3",
    "test:s3:contract": "npm run test:contract --workspace @tuddofs/s3",
    "test:ssh": "node scripts/run-tests.mjs ssh",
    "gate:surface": "node --import tsx --test src/__tests__/surface.test.ts",
    "gate:docs": "node --import tsx --test src/__tests__/docs.test.ts",
    "gate:quickstart": "node scripts/quickstart-container.mjs",
    "demo": "node --import tsx scripts/demo.ts",
    "typecheck": "npm run typecheck:core && npm run typecheck:s3",
    "typecheck:core": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:s3": "npm run typecheck --workspace @tuddofs/s3",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' 'packages/s3/src/**/*.ts' 'packages/s3/test/**/*.ts' 'fixtures/**/*.mjs' '*.mjs' '*.json' 'packages/s3/*.json' 'README.md' 'docs/**/*.md' 'packages/s3/README.md'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts' 'packages/s3/src/**/*.ts' 'packages/s3/test/**/*.ts' 'fixtures/**/*.mjs' '*.mjs' '*.json' 'packages/s3/*.json' 'README.md' 'docs/**/*.md' 'packages/s3/README.md'",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm run gate:surface && npm run gate:docs && npm test"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.2",
    "minio": "^8.0.7",
    "pg": "^8.20.0",
    "prettier": "^3.6.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.55.0"
  }
}
