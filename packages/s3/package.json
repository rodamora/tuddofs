{
  "name": "@tuddofs/s3",
  "version": "0.1.0",
  "type": "module",
  "description": "S3-compatible BlobStore adapter for tuddofs",
  "license": "MIT",
  "author": "Rod Amora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodamora/tuddofs.git",
    "directory": "packages/s3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "test": "node --import tsx --test test/*.test.ts",
    "test:contract": "node --import tsx --test test/contract.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0"
  }
}
